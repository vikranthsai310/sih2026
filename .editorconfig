root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
max_line_length = 120

# Composable functions are named in PascalCase by Compose convention, which the
# standard Kotlin function-naming rule rejects. Compose's convention wins here: a
# @Composable reads as a declarative element, not as a procedure call.
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{md,yml,yaml,json}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
