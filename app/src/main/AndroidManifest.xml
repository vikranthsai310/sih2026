<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Constraint C2: the offline claim is enforced by the platform, not asserted.
         There is deliberately NO android.permission.INTERNET and NO location
         permission here. A CI test asserts their absence (task W1.15). -->

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Required from Android 14 to show an alert over a locked screen. The platform
         grants it automatically only to alarm and calling apps; anything else has to
         ask, so the alert path must tolerate not having it (task W5.13). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />

    <uses-feature android:name="android.hardware.bluetooth" android:required="true" />
    <!-- The camera is only for scanning a pairing code, and pairing also works without
         one, so a device with no camera must still be able to install the app. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="true" />

    <!--
      enableOnBackInvokedCallback: without it the platform never routes the back gesture to
      the Compose BackHandler, and logcat said so on every navigation:
      "OnBackInvokedCallback is not enabled for the application."
      The chevron worked; the gesture would have left the application instead of returning
      to the operating screen, and an operator who swipes back off a settings page has left
      the net.
    -->
    <!--
      The launcher icon is the transmit mark from band C, not the Smart India Hackathon
      logo. SIH's logo is the organiser's mark: an application wearing it on the home screen
      reads as SIH's own software rather than an entry to it, and that is a claim this
      project has no standing to make. "iTantra" is likewise ISRO's title for the problem
      statement rather than branding of ours - REQUIREMENTS.md section 0 says so - so the
      icon is the one thing here that is genuinely the application's: the carrier leaving
      the antenna.
    -->
    <application
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="iTantra"
        android:supportsRtl="true"
        android:theme="@style/Theme.ITantra">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The engine runs screen-off; that is the normal state for a radio. -->
        <service
            android:name=".service.EngineService"
            android:foregroundServiceType="microphone"
            android:exported="false" />
    </application>
</manifest>
