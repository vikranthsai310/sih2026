# ---- Keystores and secrets ----
# Signing material and group keys must never enter version control.
*.jks
*.keystore
keystore.properties
signing.properties
secrets.properties
*.pem
*.p12

# ---- Model assets ----
# Language packs are large binaries fetched by tools/fetch-models.
# Only the manifest and checksums are tracked; see docs/MODELS.md.
models/**/*.onnx
# espeak-ng's dictionaries: 18 MB of fetched data shared by every Piper voice, and
# data rather than source. tools/fetch_models.py and the voice archives bring it.
models/tts/espeak-ng-data/
# The pruned tree and its archive are build artefacts of tools/build_espeak_min.py.
# What ships is app/src/main/assets/espeak-ng-data.zip, which is committed.
models/tts/espeak-min/
models/tts/espeak-min.zip
models/tts/**/tokens.txt
models/tts/**/MODEL_CARD
models/**/*.bin
models/**/*.pt
models/**/*.nemo
!models/manifest.json
!models/**/checksums.txt

# ---- Evaluation output ----
# Generated by the bench module; see docs/EVALUATION.md.
bench-out/
*.csv
!docs/samples/*.csv
perfetto-traces/

# ---- Python tooling ----
__pycache__/
*.pyc
.venv/
venv/

# ---- Scaffolded build ----
.kotlin/

# Fetched by tools/fetch_sherpa.sh, verified by checksum. Not tracked: 47 MB of
# native code does not belong in git history.
libs/
