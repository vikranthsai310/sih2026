# ---- Android / Gradle ----
*.iml
.gradle/
build/
captures/
local.properties
.cxx/
release/
*.apk
*.aab
*.ap_
*.dex
output.json

# ---- IDE ----
.idea/
*.ipr
*.iws
.vscode/
.DS_Store
Thumbs.db

# ---- Keystores and secrets ----
# Signing material and group keys must never enter version control.
*.jks
*.keystore
keystore.properties
signing.properties
secrets.properties
*.pem
*.p12

# ---- Model assets ----
# Language packs are large binaries fetched by tools/fetch-models.
# Only the manifest and checksums are tracked; see docs/MODELS.md.
models/**/*.onnx
models/**/*.bin
models/**/*.pt
models/**/*.nemo
!models/manifest.json
!models/**/checksums.txt

# ---- Evaluation output ----
# Generated by the bench module; see docs/EVALUATION.md.
bench-out/
*.csv
!docs/samples/*.csv
perfetto-traces/

# ---- Python tooling ----
__pycache__/
*.pyc
.venv/
venv/

# ---- Scaffolded build ----
.kotlin/
